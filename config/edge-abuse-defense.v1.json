{
  "policyVersion": "edge-abuse-defense.v1",
  "principle": "STOP_VOLUMETRIC_ABUSE_BEFORE_APPLICATION_LOGIC",
  "layers": {
    "EDGE": {
      "purpose": "DDOS_AND_VOLUMETRIC_ABUSE",
      "controls": [
        "CDN_OR_EDGE_SHIELD",
        "WAF_OR_EQUIVALENT_REQUEST_FILTERING",
        "IP_OR_NETWORK_RATE_LIMITING",
        "REQUEST_BURST_LIMITS",
        "ORIGIN_NOT_DIRECTLY_EXPOSED_WHERE_FEASIBLE"
      ]
    },
    "APPLICATION": {
      "purpose": "BOT_AND_WORKFLOW_ABUSE",
      "controls": [
        "SERVER_ISSUED_NONCE",
        "SESSION_RATE_LIMIT",
        "REPLAY_PROTECTION",
        "FORM_HONEYPOT",
        "HUMAN_PRESENCE_SIGNAL"
      ]
    },
    "IDENTITY": {
      "purpose": "WHO_IS_AUTHORIZED",
      "controls": [
        "AUTHENTICATION",
        "ORGANIZATION_CONTEXT",
        "ROLE_AND_PERMISSION_CHECKS"
      ]
    }
  },
  "boundaries": {
    "humanPresenceIsDdosMitigation": false,
    "humanPresenceVerifiesIdentity": false,
    "clientJavascriptIsSecurityBoundary": false,
    "edgeControlsRequiredBeforeProductionContactEndpoints": true
  },
  "currentStatus": "ARCHITECTURE_DEFINED / EDGE_PROVIDER_NOT_CONFIGURED"
}
