{
  "policyVersion": "purchase-search-transparency.v1",
  "mode": "TRANSPARENT_RANKING",
  "principles": {
    "queryStoredByDefault": false,
    "sourceRequiredForLiveCandidate": true,
    "sourceTimestampRequiredForLiveCandidate": true,
    "rankingCriteriaVisible": true,
    "rankingWeightsVisible": true,
    "missingDataVisible": true,
    "commercialRelationshipVisible": true,
    "sponsorshipCanInfluenceRanking": false,
    "syntheticResultsMustBeLabelled": true,
    "liveResultsMustNotBeSynthetic": true,
    "autonomousPurchase": false,
    "fiaFundCustody": false,
    "fiaFundMovement": false
  },
  "defaultWeights": {
    "fit": 35,
    "totalCost": 25,
    "risk": 20,
    "availability": 10,
    "distance": 10
  },
  "managerDisclosure": [
    "SEARCH_MODE",
    "SOURCES",
    "FETCHED_AT",
    "CRITERIA",
    "WEIGHTS",
    "SCORE_BREAKDOWN",
    "MISSING_DATA",
    "CONFIDENCE",
    "COMMERCIAL_RELATIONSHIP",
    "SPONSORSHIP_EFFECT_ON_RANKING",
    "SECURITY_LEVEL",
    "DATA_USED",
    "DATA_NOT_USED",
    "ACTIONS_NOT_TAKEN"
  ]
}
