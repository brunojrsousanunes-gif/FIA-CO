    "maxHistoricalNotes": 500,
    "requiresDataAuthorization": true,
    "requiresDataMinimization": true,
    "requiresBaselineMeasurement": true,
    "goLiveAllowed": false
  },
  "gates": {
    "precisionThreshold": null,
    "criticalFalseNegativeTolerance": 0,
    "minimumMeasuredAdministrativeBenefit": null,
    "securityReviewRequired": true,
    "legalReviewRequiredBeforeRealData": true,
    "founderApprovalRequiredForProduction": true
  }
